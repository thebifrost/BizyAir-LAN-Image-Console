# 使用说明：
# 1. 复制本文件并重命名为 .env。
# 2. 将下面的示例值替换为你自己的真实配置。
# 3. .env 通常包含密钥和管理口令，请不要提交到 Git，也不要发给他人。

# =========================
# BizyAir API 密钥配置
# =========================

# 单密钥模式：只使用一个 BizyAir API Key 时填写这一项。
# 如果同时配置了 BIZYAIR_API_KEYS，多密钥配置会优先生效。
BIZYAIR_API_KEY=replace-with-your-bizyair-key

# 多密钥模式：适合有多个 BizyAir 账号或多个 Key 时使用。
# 多个 Key 用英文逗号分隔，任务会按轮询方式分配到不同 Key。
# 启用多密钥模式时，可以注释掉上面的 BIZYAIR_API_KEY，或保留作为备用示例。
# BIZYAIR_API_KEYS=key-1,key-2,key-3

# 多密钥显示名称：可选，用来在界面或日志中区分不同 Key。
# 数量建议与 BIZYAIR_API_KEYS 保持一致，同样使用英文逗号分隔。
# 不填写时通常会使用默认编号或 Key 的部分信息进行区分。
# BIZYAIR_KEY_LABELS=Account A,Account B,Account C

# 管理后台访问令牌：用于保护管理接口或管理页面。
# 请改成随机、足够长、不可猜测的字符串，建议至少 16 位，生产环境建议 32 位以上。
ADMIN_TOKEN=replace-with-a-random-token-at-least-16-chars

# =========================
# 服务监听配置
# =========================

# 服务监听地址。
# 127.0.0.1 表示仅本机可访问，安全性更高，适合本地使用。
# 如果需要局域网其他设备访问，可改为 0.0.0.0，但请同时确认防火墙和 CORS 配置。
APP_HOST=127.0.0.1

# 服务监听端口。
# 启动后通常通过 http://127.0.0.1:8787 访问。
# 如果端口被占用，可以改成其他未占用端口。
APP_PORT=8787

# =========================
# BizyAir 接口地址
# =========================

# BizyAir 主要 API 地址，一般不需要修改。
BIZYAIR_BASE_URL=https://api.bizyair.cn/x/v1

# BizyAir 钱包/余额查询地址，一般不需要修改。
BIZYAIR_WALLET_URL=https://api.bizyair.cn/y/v1/wallet

# BizyAir 用户元数据接口地址，一般不需要修改。
BIZYAIR_METADATA_URL=https://api.bizyair.cn/x/v1/user/metadata

# =========================
# 跨域访问配置
# =========================

# CORS 允许的来源地址。
# 当 APP_HOST=127.0.0.1 且只在本机访问时，通常不需要额外配置。
# 当 APP_HOST=0.0.0.0 并允许局域网访问时，请显式添加前端页面的访问地址。
# 多个来源用英文逗号分隔，不要使用 *，避免不必要的安全风险。
# 示例：
# CORS_ORIGINS=http://127.0.0.1:8787,http://localhost:8787,http://192.168.1.10:8787

# =========================
# 本地数据与日志目录
# =========================

# 数据目录：用于保存本地运行产生的数据文件。
# 使用相对路径时，相对于项目启动目录。
DATA_DIR=./data

# 日志目录：用于保存运行日志。
LOG_DIR=./logs

# =========================
# 任务处理与轮询配置
# =========================

# 工作线程数：控制并发处理能力。
# 数值越大并发越高，但也会增加本机资源占用和 API 请求压力。
# 如果机器配置较低或遇到限流，可以适当调小。
WORKER_THREADS=32

# 轮询间隔：查询任务结果的时间间隔，单位为秒。
# 数值越小结果刷新越快，但 API 请求更频繁。
POLL_INTERVAL_SECONDS=5

# 最大轮询时长：单个任务最多等待多久，单位为秒。
# 1800 秒等于 30 分钟，超过后通常会视为超时。
MAX_POLL_SECONDS=1800

# 最大上传文件大小：单位为 MB。
# 用于限制上传到服务的图片或输入文件大小。
MAX_UPLOAD_MB=20

# 上传失败重试次数：0 表示不重试，2 表示最多额外重试 2 次。
UPLOAD_RETRY_ATTEMPTS=2

# 上传失败后的重试等待时间，单位为秒。
UPLOAD_RETRY_DELAY_SECONDS=1

# =========================
# 图片本地缓存配置
# =========================

# 图片缓存目录：可选，仅用于本地临时缓存和图片展示。
# 留空或注释时使用程序默认缓存位置。
# 如果磁盘空间有限，可以指定到空间更充足的目录。
# IMAGE_CACHE_DIR=

# 单个缓存对象或缓存分组的大小上限，单位为 MB。
IMAGE_CACHE_MAX_MB=50

# 缓存保留时间，单位为小时。
# 168 小时等于 7 天，超过后可被清理。
IMAGE_CACHE_TTL_HOURS=168

# 图片缓存总容量上限，单位为 MB。
# 2048 MB 等于 2 GB，缓存超过上限时会清理旧内容。
IMAGE_CACHE_TOTAL_MB=2048

# =========================
# 调试开关
# =========================

# 开启后会把每次请求的方法/路径/请求头/请求体，以及返回的 JSON 响应完整打到 app.log 和控制台。
# 仅用于排查问题，调试完成后请改回 0 或注释掉本行，避免日志体积膨胀和敏感信息泄露。
# 取值：1 / true / yes / on 任一即视为开启。
DEBUG_REQUESTS=0

# =========================
# OpenAI-compatible third-party provider
# =========================

# Optional. Use these when you want to route selected models to a third-party
# OpenAI-compatible image generation API instead of BizyAir.
# OPENAI_COMPAT_BASE_URL should include /v1, for example:
# OPENAI_COMPAT_BASE_URL=https://api.example.com/v1
# OPENAI_COMPAT_API_KEY=replace-with-third-party-key
# OPENAI_COMPAT_MODELS=gpt-image-1,my-custom-image-model
# OPENAI_COMPAT_LABEL=Third Party OpenAI
# OPENAI_COMPAT_TIMEOUT_SECONDS=300

# Optional advanced override. JSON object keyed by model name. This can customize
# UI fields and validation. The provider must match OPENAI_COMPAT_PROVIDER_ID
# when routing the model to the third-party provider.
# CUSTOM_MODEL_SCHEMAS={"my-custom-image-model":{"sizes":["auto","1024x1024","1536x1024","1024x1536","2048x2048"],"aspectRatios":[],"resolutions":[],"qualities":["auto","low","medium","high"],"variants":[1,2,4],"maxUrls":10,"outputFormats":["png","jpeg","webp"],"moderations":["auto","low"],"seed":true,"provider":"openai_compatible"}}
