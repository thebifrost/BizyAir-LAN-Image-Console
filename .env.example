# Copy this file to .env and fill in real values.
# Single-key mode remains supported:
BIZYAIR_API_KEY=replace-with-your-bizyair-key
# Multi-key mode: tasks are assigned to keys in round-robin order.
# BIZYAIR_API_KEYS=key-1,key-2,key-3
# BIZYAIR_KEY_LABELS=Account A,Account B,Account C
ADMIN_TOKEN=replace-with-a-random-token-at-least-16-chars

# Local-only by default. Use 0.0.0.0 only after you are ready for LAN access.
APP_HOST=127.0.0.1
APP_PORT=8787

BIZYAIR_BASE_URL=https://api.bizyair.cn/x/v1
BIZYAIR_WALLET_URL=https://api.bizyair.cn/y/v1/wallet
BIZYAIR_METADATA_URL=https://api.bizyair.cn/x/v1/user/metadata

# Add LAN origins explicitly when using APP_HOST=0.0.0.0, for example:
# CORS_ORIGINS=http://127.0.0.1:8787,http://localhost:8787,http://192.168.1.10:8787

DATA_DIR=./data
LOG_DIR=./logs
WORKER_THREADS=32
POLL_INTERVAL_SECONDS=5
MAX_POLL_SECONDS=1800
MAX_UPLOAD_MB=20

# Optional local temp cache for image display only
# IMAGE_CACHE_DIR=
IMAGE_CACHE_MAX_MB=50
IMAGE_CACHE_TTL_HOURS=168
IMAGE_CACHE_TOTAL_MB=2048
